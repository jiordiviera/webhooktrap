{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Webhook Trap",
  "description": "Capture real webhooks, replay them against your handler the way providers deliver them, and fail the build when your database ends up wrong.",
  "colors": {
    "primary": "#b12083",
    "light": "#e977bb",
    "dark": "#b12083"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://app.webhooktrap.dev"
  },
  "favicon": {
    "light": "/favicon-light.svg",
    "dark": "/favicon-dark.svg"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#f7f7f4",
      "dark": "#141411"
    }
  },
  "fonts": {
    "heading": {
      "family": "Archivo",
      "weight": 700
    },
    "body": {
      "family": "Archivo",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/jiordiviera/webhooktrap"
      },
      {
        "label": "Status",
        "href": "https://status.webhooktrap.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.webhooktrap.dev"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart", "concepts", "install"]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/stripe",
          "guides/github",
          "guides/shopify",
          "guides/standard-webhooks",
          "guides/ci",
          "guides/self-hosting",
          "guides/verify-download"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/configuration",
          "reference/fixtures",
          "reference/scenarios",
          "reference/findings",
          "reference/capture-endpoint",
          "reference/limits"
        ]
      },
      {
        "group": "Trust",
        "pages": ["security", "changelog"]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/jiordiviera",
      "github": "https://github.com/jiordiviera/webhooktrap"
    }
  }
}
