{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://webhooktrap.dev/contracts/agent/v1/pair.request.schema.json",
    "title": "POST /agent/v1/pair (§5.1)",
    "type": "object",
    "properties": {
        "proto": {
            "$ref": "common.schema.json#/$defs/proto"
        },
        "code": {
            "type": "string",
            "pattern": "^[0-9A-Za-z]{5}-?[0-9A-Za-z]{5}$"
        },
        "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$",
            "description": "base64 of the 32-byte Ed25519 public key"
        },
        "name": {
            "$ref": "common.schema.json#/$defs/agentName"
        },
        "version": {
            "$ref": "common.schema.json#/$defs/semver"
        },
        "os": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,16}$"
        },
        "arch": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,16}$"
        },
        "proto_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
        },
        "proto_max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
        }
    },
    "required": [
        "proto",
        "code",
        "public_key",
        "name",
        "version",
        "os",
        "arch",
        "proto_min",
        "proto_max"
    ],
    "additionalProperties": false
}
