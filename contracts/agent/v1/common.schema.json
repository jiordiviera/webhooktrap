{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://webhooktrap.dev/contracts/agent/v1/common.schema.json",
    "title": "Shared definitions, agent protocol v1 (contracts.md §5)",
    "$defs": {
        "proto": {
            "const": 1
        },
        "agentId": {
            "type": "string",
            "pattern": "^agt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "jobId": {
            "type": "string",
            "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "runId": {
            "type": "string",
            "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "captureId": {
            "type": "string",
            "pattern": "^cap_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
            "description": "RFC 3339 UTC (JSON-1); the server sends milliseconds"
        },
        "semver": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})(-[0-9A-Za-z.-]{1,32})?$"
        },
        "agentName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,48}$",
            "description": "§5.11"
        },
        "probeName": {
            "type": "string",
            "pattern": "^[a-z0-9_.]{1,48}$",
            "description": "PV-9, PRB-2"
        },
        "envName": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$",
            "description": "TM-39"
        },
        "providerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
        },
        "code": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$",
            "description": "a machine code, never prose"
        },
        "eventType": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
        },
        "scenario": {
            "enum": [
                "once",
                "twice",
                "shuffled",
                "late",
                "retry",
                "tampered",
                "unsigned",
                "burst",
                "slow_budget"
            ]
        },
        "mode": {
            "enum": [
                "normal",
                "duplicate",
                "retry",
                "late",
                "tampered",
                "unsigned"
            ]
        },
        "signing": {
            "type": "object",
            "properties": {
                "kind": {
                    "enum": [
                        "resigned",
                        "original",
                        "original_body_fresh_ts",
                        "none"
                    ]
                },
                "timestamp_offset_s": {
                    "type": "integer",
                    "minimum": -604800,
                    "maximum": 604800
                }
            },
            "required": ["kind"],
            "additionalProperties": false
        },
        "transport": {
            "enum": ["timeout", "reset", "refused", "dns", "tls"]
        },
        "httpStatus": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
        },
        "ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
        },
        "severity": {
            "enum": ["critical", "high", "medium", "info"]
        },
        "deliveryResult": {
            "enum": [
                "pass",
                "finding",
                "inconclusive",
                "unreachable",
                "sent_no_result",
                "not_run"
            ]
        },
        "scenarioResult": {
            "enum": [
                "pass",
                "finding",
                "inconclusive",
                "unreachable",
                "n/a",
                "not_run"
            ]
        },
        "displayValue": {
            "type": ["string", "null"],
            "maxLength": 32,
            "description": "PV-2 / PV-5 display form; the server stores anything outside PV-11 as #invalid"
        },
        "display": {
            "type": "object",
            "properties": {
                "before": {
                    "$ref": "common.schema.json#/$defs/displayValue"
                },
                "after": {
                    "$ref": "common.schema.json#/$defs/displayValue"
                },
                "expected": {
                    "$ref": "common.schema.json#/$defs/displayValue"
                }
            },
            "required": ["before", "after"],
            "additionalProperties": false
        },
        "tamper": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\[\\]-]{1,200}$"
                },
                "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:#+-]{0,64}$"
                },
                "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:#+-]{0,64}$"
                }
            },
            "required": ["path", "from", "to"],
            "additionalProperties": false
        },
        "response": {
            "type": "object",
            "properties": {
                "content_type": {
                    "anyOf": [
                        {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "^[\\x20-\\x7e]*$"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "body_sha256": {
                    "$ref": "common.schema.json#/$defs/sha256"
                },
                "body_bytes": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": ["content_type", "body_sha256", "body_bytes"],
            "additionalProperties": false
        },
        "reading": {
            "type": "object",
            "properties": {
                "name": {
                    "$ref": "common.schema.json#/$defs/probeName"
                },
                "changed": {
                    "type": ["boolean", "null"]
                },
                "matches_expected": {
                    "type": ["boolean", "null"]
                },
                "flagged": {
                    "type": "boolean"
                },
                "display": {
                    "$ref": "common.schema.json#/$defs/display"
                }
            },
            "required": [
                "name",
                "changed",
                "matches_expected",
                "flagged",
                "display"
            ],
            "additionalProperties": false
        },
        "state": {
            "type": "object",
            "properties": {
                "readings": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "$ref": "common.schema.json#/$defs/reading"
                    }
                },
                "failed": {
                    "type": "boolean"
                },
                "unsettled": {
                    "type": "boolean"
                }
            },
            "required": ["readings", "failed", "unsettled"],
            "additionalProperties": false
        },
        "evidence": {
            "type": "object",
            "properties": {
                "d": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                },
                "role": {
                    "enum": ["offending", "reference"]
                }
            },
            "required": ["d", "role"],
            "additionalProperties": false
        },
        "findingType": {
            "enum": [
                "accepts_tampered",
                "accepts_unsigned",
                "accepts_stale",
                "duplicate_changed_state",
                "order_changed_state",
                "concurrent_changed_state",
                "partial_side_effect",
                "retry_diverged",
                "server_error",
                "non_2xx_on_valid",
                "error_on_invalid",
                "over_budget",
                "needs_probe",
                "order_dependent",
                "probe_gap",
                "cold_start",
                "async_write"
            ]
        },
        "probeEntry": {
            "type": "object",
            "properties": {
                "name": {
                    "$ref": "common.schema.json#/$defs/probeName"
                },
                "display_mode": {
                    "enum": ["count", "code", "opted_number", "opted_value"]
                },
                "covers": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z_]{1,48}$"
                    }
                }
            },
            "required": ["name", "display_mode"],
            "additionalProperties": false
        },
        "target": {
            "type": "object",
            "properties": {
                "scheme": {
                    "enum": ["http", "https"]
                },
                "host": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9.:_\\[\\]-]{1,253}$"
                },
                "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            },
            "required": ["scheme", "host", "port"],
            "additionalProperties": false
        },
        "error": {
            "type": "object",
            "properties": {
                "proto": {
                    "$ref": "common.schema.json#/$defs/proto"
                },
                "error": {
                    "$ref": "common.schema.json#/$defs/code"
                }
            },
            "required": ["error"]
        }
    }
}
