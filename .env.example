# Webhook Trap 2.0 — environment variable NAMES only (compose-profile.md §5). No values here.
# Uncomment a name to set it; commented names fall back to the defaults in config/*.php.
# Secrets also accept <NAME>_FILE (read by the image entrypoint), so they stay out of `docker inspect`.
# Local development with lerd: see README.md (`lerd env setup` writes the service values).

# Instance
# Secrets: local development may set them here. In containers every secret comes from a file
# in secrets/ (Compose secret, read by the entrypoint) or <NAME>_FILE: APP_KEY, DB_PASSWORD,
# REDIS_PASSWORD, REVERB_APP_SECRET, MAIL_PASSWORD, GITHUB_/GOOGLE_CLIENT_SECRET, ERROR_TRACKER_DSN,
# IDENTITY_*_KEY, AGENT_PAIRING_HMAC_KEY (compose-profile §5). Never put them in .env.production.
APP_KEY=
# APP_PREVIOUS_KEYS=
# APP_NAME=
# APP_ENV=
# APP_DEBUG=
# APP_URL=
# APP_VERSION=
# APP_LOCALE=
# APP_FALLBACK_LOCALE=
# APP_FAKER_LOCALE=
# APP_MAINTENANCE_DRIVER=
# LOG_CHANNEL=
# LOG_STACK=
# LOG_LEVEL=
# LOG_DEPRECATIONS_CHANNEL=

# Hosts and TLS (image Caddyfile)
# SERVER_NAME=
# APP_HOST=
# CAPTURE_HOST=
# WS_HOST=
# TLS_MODE=
# CADDY_AUTO_HTTPS=
# CADDY_HTTP_PORT=
# CADDY_HTTPS_PORT=
# HTTP_PORT=
# HTTPS_PORT=
# BIND_ADDRESS=
# ACME_EMAIL=
# App default `none`; the image sets `secret`. lerd dev: leave unset (nginx does not strip a
# client-sent X-WT-Verified); set it only to exercise the trusted path on purpose.
# PROXY_TRUST_MODE=
# EDGE_PROXY_SECRET_FILE=
# TRUSTED_PROXIES=
# APP_MAX_BODY=
# Ingest service (capture path; compose-profile §2.3). Defaults: 8 threads, 15s.
# INGEST_NUM_THREADS=
# INGEST_READ_BODY_TIMEOUT=
# HAProxy capture gate (compose-profile §2.4). Per address: 20 in flight, 1200/min, 2 partial
# bodies in flight; partial bodies in total: INGEST_NUM_THREADS - 2 (set both together).
# WT_CAPTURE_MAX_CONN=
# WT_CAPTURE_MAX_RATE=
# WT_CAPTURE_MAX_STREAM=
# WT_CAPTURE_STREAM_SLOTS=
# ENGINE_SOCKET=

# Capture
# CAPTURE_PUBLIC_ORIGIN=
# CAPTURE_TRUST_FORWARDED_ORIGIN=
# CAPTURE_PROXY_HEADERS=
# CAPTURE_BODY_KEEP_MAX_BYTES=
# CAPTURE_REQUEST_MAX_BYTES=
# STORAGE_WATERMARK_PERCENT=
# STORAGE_BUDGET_BYTES=
# STORAGE_BUDGET_WARN_PERCENT=

# Database (PostgreSQL)
# DB_CONNECTION=
# DB_HOST=
# DB_PORT=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_PASSWORD_FILE=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD_FILE=
# PG_SHARED_BUFFERS=
# PG_EFFECTIVE_CACHE_SIZE=

# Redis-compatible store (Valkey or Redis): queue, cache, rate limits
# REDIS_CLIENT=
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
# REDIS_PASSWORD_FILE=
# VALKEY_MAXMEMORY=

# Laravel drivers
# QUEUE_CONNECTION=
# REDIS_QUEUE_RETRY_AFTER=
# CACHE_STORE=
# CACHE_FAILURE_REPORT_STORE=
# SESSION_DRIVER=
# SESSION_LIFETIME=
# BROADCAST_CONNECTION=
# FILESYSTEM_DISK=
# HORIZON_PREFIX=

# Reverb (client events are fixed to `none` in config; there is deliberately no variable for it)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_APP_SECRET_FILE=
# REVERB_HOST=
# REVERB_PORT=
# REVERB_SCHEME=
# REVERB_SERVER_HOST=
# REVERB_SERVER_PORT=
# REVERB_SCALING_ENABLED=
# REVERB_PUBLIC_HOST=
# REVERB_APP_MAX_CONNECTIONS=
# REVERB_MIN_NOFILE=
# REALTIME_MAX_CONNECTIONS_PER_PRINCIPAL=
# REALTIME_MAX_CONNECTION_LIFETIME_SECONDS=
# LONGPOLL_AGENT_SLOTS=
# LONGPOLL_HTTP_WORKERS=
# APP_NUM_THREADS=
# LONGPOLL_RUNNER_SLOTS=
# LONGPOLL_MAX_WAIT_SECONDS=
# LONGPOLL_RETRY_AFTER_SECONDS=

# Mail
# MAIL_MAILER=
# MAIL_SCHEME=
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_PASSWORD_FILE=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=

# Identity (instance profile, guest mode, WebAuthn relying party)
# WEBHOOKTRAP_INSTANCE=
# GUEST_MODE=
# WEBAUTHN_RP_ID=
# WEBAUTHN_RP_NAME=
# Dedicated Identity keys (32+ bytes, or base64:...): never APP_KEY, kept out of backups.
# The app refuses to serve without them. IDENTITY_EMAIL_HMAC_KEY must never change.
# Containers: from secrets/identity_email_hmac_key (Compose secret), never a plain value.
IDENTITY_EMAIL_HMAC_KEY=
# IDENTITY_EMAIL_HMAC_KEY_FILE=
# Containers: from secrets/identity_recovery_code_key.
IDENTITY_RECOVERY_CODE_KEY=
# IDENTITY_RECOVERY_CODE_KEY_FILE=

# Agent protocol (contracts §5). Pairing codes are HMAC'd with this key (32+ bytes): never APP_KEY.
AGENT_PAIRING_HMAC_KEY=
# AGENT_PAIRING_HMAC_KEY_FILE=
# AGENT_SERVER_ORIGIN=
# Local development only (APP_ENV local or testing): accept `0.0.0-dev` agent builds.
# AGENT_ALLOW_DEV_BUILDS=

# OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CLIENT_SECRET_FILE=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET_FILE=

# Password hashing (argon2id only; the driver itself is not configurable)
# ARGON_MEMORY=
# ARGON_TIME=
# ARGON_THREADS=
# PASSWORD_HASH_MAX_CONCURRENT=

# Server runs and runner
# SERVER_REPLAY_PUBLIC=
# WEBHOOKTRAP_ALLOW_PRIVATE_REPLAY_TARGETS=
# RUNNER_SERVER_ORIGIN=
# RUNNER_TOKEN_FILE=
# RUNNER_CONCURRENCY=

# Backup and deletion ledger
# BACKUP_ENABLED=
# BACKUP_BEFORE_MIGRATE=
# BACKUP_REPO_TYPE=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=
# BACKUP_S3_BUCKET=
# BACKUP_S3_KEY_FILE=
# BACKUP_S3_SECRET_FILE=
# BACKUP_CIPHER_PASS_FILE=
# BACKUP_RETENTION_FULL=
# BACKUP_FULL_SCHEDULE=
# LEDGER_PATH=
# LEDGER_AGE_RECIPIENT=
# LEDGER_RETENTION_DAYS=
# LEDGER_SHIP_INTERVAL_SECONDS=
# LEDGER_S3_PREFIX=

# Sign-in alert and error tracking
# SIGNIN_ALERT_WINDOW_SECONDS=
# SIGNIN_ALERT_WARN_FAILURES=
# SIGNIN_ALERT_WARN_THROTTLED=
# SIGNIN_ALERT_CRIT_FAILURES=
# OPS_ALERT_EMAIL=
# ERROR_TRACKER_DSN=
# ERROR_TRACKER_SEND_BODIES=

# Admin bootstrap and self-host image
# ADMIN_SETUP_TOKEN=
# WEBHOOKTRAP_VERSION=

# Deploy (written into .env.deploy by deploy.sh on the VPS, never by hand)
# APP_IMAGE=
# APP_DIGEST=
# IMAGE_TAG=
# PG_IMAGE=
# PG_DIGEST=
# APP_PORT=

# Front end (build time; the Reverb connection reaches the browser at runtime instead)
# VITE_APP_NAME=
