#!/bin/sh
# Forced command of the `webhooktrap-deploy` SSH key (ci-cd.md §4; the private hosted deployment plan).
# Installed root-owned next to deploy.sh, as <APP_DIR>/bin/deploy-gate; authorized_keys line:
#   command="<APP_DIR>/bin/deploy-gate",restrict ssh-ed25519 AAAA... deploy@github
# It accepts exactly two forms and passes them, as arguments, to deploy.sh through sudo:
#   deploy <40-hex sha> <sha256:64-hex app digest> <sha256:64-hex pg digest>
#   rollback
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
cmd="${SSH_ORIGINAL_COMMAND:-}"
# deploy.sh is installed beside this script; the sudoers line names that exact path.
here=$(cd "$(dirname "$0")" && pwd)
hex40='[0-9a-f]\{40\}'
digest='sha256:[0-9a-f]\{64\}'
# One line only: grep -x matches per line, so a second line must not ride along.
[ "$(printf '%s' "$cmd" | wc -l)" -eq 0 ] || { echo "deploy-gate: refused" >&2; exit 64; }
if [ "$cmd" = rollback ]; then
    exec sudo -n "$here/deploy.sh" rollback
fi
if printf '%s\n' "$cmd" | grep -qx "deploy $hex40 $digest $digest"; then
    # shellcheck disable=SC2086 # the grammar above allows only safe tokens
    set -- $cmd
    exec sudo -n "$here/deploy.sh" "$1" "$2" "$3" "$4"
fi
echo "deploy-gate: refused" >&2
exit 64
