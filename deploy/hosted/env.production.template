# .env.production for the hosted instance (webhooktrap.dev), written by deploy/bin/c3-finish.sh
# into $APP_DIR/.env.production (root 0600; Compose reads it, every app-family service gets it).
#
# SETTINGS ONLY. No secret ever goes here (policy P-20, compose-profile.md §5): every secret is a
# file in $APP_DIR/secrets/, read by the image entrypoint. Values marked "PO:" must be confirmed by
# the PO before the first deploy; "__GENERATE__" is filled by c3-finish.sh on first write.
# APP_IMAGE, APP_DIGEST, PG_IMAGE, PG_DIGEST and APP_PORT are not here: deploy.sh writes them to
# .env.deploy. PROXY_TRUST_MODE, WT_ROLE, INGEST_* and APP_NUM_THREADS are pinned in the Compose file.

# Instance
APP_NAME="Webhook Trap"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.webhooktrap.dev
APP_LOCALE=en
WEBHOOKTRAP_INSTANCE=hosted
# PO: guest capture without an account (decision 41 era default: on).
GUEST_MODE=true
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Hosts (the image Caddyfile). TLS is at the host proxy; the app listens on :8080 behind it.
# The app host is every name that is not the capture or WebSocket host (APP_URL above).
SERVER_NAME=:8080
CADDY_AUTO_HTTPS=off
CAPTURE_HOST=in.webhooktrap.dev
WS_HOST=ws.webhooktrap.dev
APP_MAX_BODY=10MiB

# Capture
# Shown to owners as their capture URL origin (http is accepted too; no redirect on in.).
CAPTURE_PUBLIC_ORIGIN=https://in.webhooktrap.dev

# Database: the `postgres` service, session connections only (P-19). The password is a file.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=webhooktrap
DB_USERNAME=webhooktrap
POSTGRES_DB=webhooktrap
POSTGRES_USER=webhooktrap
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# Valkey: queue, cache, sessions, rate limits. The password is a file.
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
# About 75 % of the valkey container limit (384m, compose-profile.md §3).
VALKEY_MAXMEMORY=288mb
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb

# Reverb. The app and the workers reach it on the internal network; browsers connect on the app
# origin (decision 62). The id and key are public identifiers, generated once; the secret is a file.
REVERB_APP_ID=__GENERATE__
REVERB_APP_KEY=__GENERATE__
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_MAX_CONNECTIONS=3000

# Agents and long-poll (compose-profile.md §3.2): half of the app's 12 threads.
AGENT_SERVER_ORIGIN=https://app.webhooktrap.dev
LONGPOLL_AGENT_SLOTS=6

# Identity
# WebAuthn relying party: the apex (PO, 2026-11-16), so passkeys survive a change of app
# subdomain. Allowed origin stays APP_URL only. It can never change once users have passkeys.
WEBAUTHN_RP_ID=webhooktrap.dev
WEBAUTHN_RP_NAME="Webhook Trap"

# Mail. PO: the 2.0 mail account; until it exists mail goes to the log (mail_password stays empty).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@webhooktrap.dev
MAIL_FROM_NAME="Webhook Trap"

# OAuth. PO: the 2.0 apps; ids are not secrets, the secrets are files (empty = sign-in off).
GITHUB_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Backups (wt-backup). PO: the R2 bucket and endpoint (HD-3); the key and secret are files.
# Until the endpoint, bucket and both key files are set, `backup` fails and every deploy after
# the first stops at its pre-migrate backup (ci-cd.md §4 step 4).
BACKUP_REPO_TYPE=s3
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_RETENTION_FULL=14
BACKUP_FULL_SCHEDULE=02:30
# PO: the public age recipient of the deletion-ledger copies (age1...); the identity stays off-box.
LEDGER_AGE_RECIPIENT=
LEDGER_RETENTION_DAYS=21
LEDGER_SHIP_INTERVAL_SECONDS=60
LEDGER_S3_PREFIX=ledger/
