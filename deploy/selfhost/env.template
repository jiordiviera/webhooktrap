# .env for a self-hosted Webhook Trap instance, written by deploy/selfhost/install.sh.
# SETTINGS ONLY: every secret is a file in ./secrets (read by the image entrypoint), never here.
# Placeholders __LIKE_THIS__ are filled by install.sh. Reference: docs/guides/self-hosting.mdx.

# Release. Every image uses this tag; change it to upgrade or roll back.
WEBHOOKTRAP_VERSION=__VERSION__

# Instance
APP_NAME="Webhook Trap"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://__APP_HOST__
APP_LOCALE=en
WEBHOOKTRAP_INSTANCE=selfhost
# Guest capture without an account. false: only signed-in users capture.
GUEST_MODE=false
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Hosts. The app host is every name that is not the capture or WebSocket host.
CAPTURE_HOST=__CAPTURE_HOST__
WS_HOST=__WS_HOST__
CAPTURE_PUBLIC_ORIGIN=https://__CAPTURE_HOST__
APP_MAX_BODY=10MiB

# TLS (install.sh --tls). auto: FrankenPHP gets certificates itself on ports 80 and 443.
# off: your reverse proxy terminates TLS and forwards to BIND_ADDRESS:HTTP_PORT.
SERVER_NAME=__SERVER_NAME__
CADDY_AUTO_HTTPS=__CADDY_AUTO_HTTPS__
PROXY_TRUST_MODE=__PROXY_TRUST_MODE__
BIND_ADDRESS=__BIND_ADDRESS__
HTTP_PORT=__HTTP_PORT__
# off: nothing answers TLS on HTTPS_PORT (loopback only); it only has to be a free port, because
# your proxy already holds 443.
HTTPS_PORT=__HTTPS_PORT__

# Database: the `postgres` service. The password is secrets/postgres_password (= db_password).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=webhooktrap
DB_USERNAME=webhooktrap
POSTGRES_DB=webhooktrap
POSTGRES_USER=webhooktrap
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# Valkey: queue, cache, sessions, rate limits. REDIS_HOST may point at your own Redis or Valkey.
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
VALKEY_MAXMEMORY=288mb
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb

# Reverb. The id and key are public identifiers; the secret is secrets/reverb_app_secret.
REVERB_APP_ID=__REVERB_APP_ID__
REVERB_APP_KEY=__REVERB_APP_KEY__
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Agents pair with this origin (webhooktrap pair --server https://__APP_HOST__).
AGENT_SERVER_ORIGIN=https://__APP_HOST__

# Passkeys. The relying party id can never change once users have passkeys.
WEBAUTHN_RP_ID=__APP_HOST__
WEBAUTHN_RP_NAME="Webhook Trap"

# Mail. Without a mailer, mail goes to the log (docker compose logs horizon).
# SMTP: MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME; the password is secrets/mail_password.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@__APP_HOST__
MAIL_FROM_NAME="Webhook Trap"

# OAuth sign-in (optional). Ids here, secrets in secrets/github_client_secret and
# secrets/google_client_secret; an empty secret file turns that method off.
GITHUB_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Server runner: public targets only (default), or allowlist with a file in ./runner/.
RUNNER_GUARD_CEILING=public

# Backups (the `backup` service, pgBackRest). posix keeps the repository on this disk, which is
# not a disaster backup: use s3 (any S3-compatible store) with secrets/backup_s3_key and
# secrets/backup_s3_secret.
BACKUP_REPO_TYPE=posix
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_RETENTION_FULL=14
BACKUP_FULL_SCHEDULE=02:30
# Optional: an age public key (age1...) to ship encrypted copies of the deletion ledger next to
# the backups. Keep the matching identity off this server; restore needs it.
LEDGER_AGE_RECIPIENT=
LEDGER_RETENTION_DAYS=21
LEDGER_SHIP_INTERVAL_SECONDS=60
LEDGER_S3_PREFIX=ledger/
